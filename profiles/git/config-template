# this config is managed by gohdotfiles.
# manual changes may be overwritten at any point.

[column]
	ui = auto

[branch]
	sort = -committerdate

[tag]
	sort = version:refname

[init]
	defaultBranch = main

[diff]
	context = 10
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true

[push]
	default = simple
	autoSetupRemote = true
	followTags = true

[pull]
	rebase = true

[fetch]
	prune = true
	pruneTags = true
	all = true

[help]
	autocorrect = prompt

[commit]
	verbose = true
	template = {{COMMIT_TEMPLATE_FILE}}

[rerere]
	enabled = true
	autoupdate = true

[core]
	excludesfile = ~/.gitignore

[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true

